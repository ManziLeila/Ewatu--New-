generator client {
  provider = "prisma-client-js"
  // Explicit local output so this service's Prisma client is never shadowed by (or shadows)
  // another service's generated client at the npm workspace root -- see the shared
  // node_modules/@prisma/client hoisting issue this fixes.
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum EmployeeType {
  INTERNAL
  OUTSOURCED
  SECONDED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  SECONDMENT
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PeriodStatus {
  DRAFT
  SUBMITTED
  HR_APPROVED
  MD_APPROVED
  CLIENT_APPROVED
  FINALIZED
}

enum ApproverRole {
  HR_MANAGER
  MD
  CLIENT_ADMIN
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum DeploymentStatus {
  ACTIVE
  ON_LEAVE
  RECALLED
  TRANSFERRED
  ON_BENCH
}

enum OutsourcingEmploymentType {
  FULL_TIME
  PART_TIME
  FIXED_TERM
}

enum SecondmentContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

model PayrollConfiguration {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  clientId              String   @map("client_id")
  payFrequency          String   @default("MONTHLY") @map("pay_frequency")
  payDay                Int      @default(28) @map("pay_day")
  currency              String   @default("RWF")
  payeEnabled           Boolean  @default(true) @map("paye_enabled")
  rssbPensionEmployee   Decimal  @default(0.05) @map("rssb_pension_employee") @db.Decimal(6,4)
  rssbPensionEmployer   Decimal  @default(0.05) @map("rssb_pension_employer") @db.Decimal(6,4)
  rssbMedical           Decimal  @default(0.075) @map("rssb_medical") @db.Decimal(6,4)
  cbhiRate              Decimal  @default(0.005) @map("cbhi_rate") @db.Decimal(6,4)
  maternityLevy         Decimal  @default(0.003) @map("maternity_levy") @db.Decimal(6,4)
  occupationalHazardRate Decimal @default(0.02) @map("occupational_hazard_rate") @db.Decimal(6,4)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, clientId])
  @@index([tenantId])
  @@map("payroll_configurations")
}

model Employee {
  id                    String           @id @default(uuid())
  tenantId              String           @map("tenant_id")
  candidateId           String?          @map("candidate_id")
  clientId              String?          @map("client_id")
  employeeType          EmployeeType     @default(OUTSOURCED) @map("employee_type")
  firstName             String           @map("first_name")
  lastName              String           @map("last_name")
  email                 String
  phone                 String?
  nationalIdEncrypted   String?          @map("national_id_encrypted")
  dateOfBirth           DateTime?        @map("date_of_birth")
  gender                String?
  nationality           String?
  department            String?
  location              String?
  jobTitle              String           @map("job_title")
  startDate             DateTime         @map("start_date")
  endDate               DateTime?        @map("end_date")
  probationEndDate      DateTime?        @map("probation_end_date")
  employmentStatus      EmploymentStatus @default(ACTIVE) @map("employment_status")
  managerId             String?          @map("manager_id")
  basicSalary           Decimal          @default(0) @map("basic_salary") @db.Decimal(15,2)
  housingAllowance      Decimal          @default(0) @map("housing_allowance") @db.Decimal(15,2)
  transportAllowance    Decimal          @default(0) @map("transport_allowance") @db.Decimal(15,2)
  otherAllowances       Decimal          @default(0) @map("other_allowances") @db.Decimal(15,2)
  bankAccountEncrypted  String?          @map("bank_account_encrypted")
  bankName              String?          @map("bank_name")
  bankBranch            String?          @map("bank_branch")
  emergencyContactName  String?          @map("emergency_contact_name")
  emergencyContactPhone String?          @map("emergency_contact_phone")
  rssbNumber            String?          @map("rssb_number") @db.VarChar(32)
  ramaEnabled           Boolean          @default(true) @map("rama_enabled")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  manager               Employee?        @relation("EmployeeManager", fields: [managerId], references: [id])
  reports               Employee[]       @relation("EmployeeManager")
  contracts             EmployeeContract[]
  payrollRecords        PayrollRecord[]
  outsourcingAssignments OutsourcingAssignment[]
  leaveRequests         LeaveRequest[]
  delegatedLeaveRequests LeaveRequest[] @relation("LeaveDelegate")
  leaveBalances         LeaveBalance[]
  goals                 Goal[]
  appraisals            Appraisal[]
  feedbackNominees      FeedbackRequest[] @relation("FeedbackNominee")
  feedbackReviewers     FeedbackRequest[] @relation("FeedbackReviewer")
  performanceImprovementPlans PerformanceImprovementPlan[]
  permits               Permit[]
  teamMemberships       TeamMember[]
  documents             EmployeeDocument[]
  tasks                 Task[]
  grievancesRaised      GrievanceCase[]
  attendanceRecords     AttendanceRecord[]
  trainingRecords       TrainingRecord[]

  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, employmentStatus])
  @@map("employees")
}

model EmployeeDocument {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  employeeId String    @map("employee_id")
  name       String
  s3Key      String    @map("s3_key")
  expiryDate DateTime? @map("expiry_date")
  uploadedAt DateTime  @default(now()) @map("uploaded_at")

  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@map("employee_documents")
}

enum GrievanceCategory {
  HARASSMENT
  DISCRIMINATION
  WORKPLACE_CONDITIONS
  PAY_DISPUTE
  POLICY_VIOLATION
  OTHER
}

enum GrievanceStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model GrievanceCase {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  raisedByEmployeeId String            @map("raised_by_employee_id")
  category           GrievanceCategory @default(OTHER)
  description        String
  status             GrievanceStatus   @default(OPEN)
  handledByName      String?           @map("handled_by_name")
  resolutionNotes    String?           @map("resolution_notes")
  createdAt          DateTime          @default(now()) @map("created_at")
  resolvedAt         DateTime?         @map("resolved_at")

  raisedBy           Employee          @relation(fields: [raisedByEmployeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("grievance_cases")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  tenantId   String           @map("tenant_id")
  employeeId String           @map("employee_id")
  date       DateTime         @db.Date
  clockInAt  DateTime?        @map("clock_in_at")
  clockOutAt DateTime?        @map("clock_out_at")
  status     AttendanceStatus @default(PRESENT)
  createdAt  DateTime         @default(now()) @map("created_at")

  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([tenantId, date])
  @@map("attendance_records")
}

/// Restricts clock-in/out to the tenant's office network, identified by the caller's
/// public IP address (the only signal a server can actually verify — there is no way
/// to check WiFi SSID over HTTP). One policy per tenant; disabled by default so existing
/// tenants aren't locked out until an admin opts in.
model AttendanceNetworkPolicy {
  id             String   @id @default(uuid())
  tenantId       String   @unique @map("tenant_id")
  enabled        Boolean  @default(false)
  allowedCidrs   String[] @map("allowed_cidrs")
  updatedByEmail String?  @map("updated_by_email")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("attendance_network_policies")
}

enum TrainingRecordStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model TrainingCourse {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  name        String
  description String?
  mandatory   Boolean          @default(true)
  dueDate     DateTime?        @map("due_date")
  createdAt   DateTime         @default(now()) @map("created_at")

  records     TrainingRecord[]

  @@index([tenantId])
  @@map("training_courses")
}

model TrainingRecord {
  id          String               @id @default(uuid())
  tenantId    String               @map("tenant_id")
  courseId    String               @map("course_id")
  employeeId  String               @map("employee_id")
  status      TrainingRecordStatus @default(NOT_STARTED)
  completedAt DateTime?            @map("completed_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  course      TrainingCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee    Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([courseId, employeeId])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("training_records")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model Task {
  id             String     @id @default(uuid())
  tenantId       String     @map("tenant_id")
  employeeId     String     @map("employee_id")
  assignedByName String     @map("assigned_by_name")
  title          String
  description    String?
  dueDate        DateTime?  @map("due_date")
  status         TaskStatus @default(PENDING)
  completedAt    DateTime?  @map("completed_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@map("tasks")
}

model Announcement {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  teamId       String?  @map("team_id")
  title        String
  body         String
  postedByName String   @map("posted_by_name")
  createdAt    DateTime @default(now()) @map("created_at")

  team         Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, teamId])
  @@map("announcements")
}

enum TeamMemberRole {
  LEAD
  CORE
  MEMBER
}

model Team {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  parentTeamId String?  @map("parent_team_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parentTeam   Team?    @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  subTeams     Team[]   @relation("TeamHierarchy")
  members      TeamMember[]
  kpiSubmissions TeamKpiSubmission[]
  announcements  Announcement[]

  @@index([tenantId])
  @@map("teams")
}

model TeamMember {
  id         String         @id @default(uuid())
  tenantId   String         @map("tenant_id")
  teamId     String         @map("team_id")
  employeeId String         @map("employee_id")
  role       TeamMemberRole @default(MEMBER)
  createdAt  DateTime       @default(now()) @map("created_at")

  team       Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@index([tenantId])
  @@index([employeeId])
  @@map("team_members")
}

model EmployeeContract {
  id                    String         @id @default(uuid())
  tenantId              String         @map("tenant_id")
  employeeId            String         @map("employee_id")
  contractType          ContractType   @default(PERMANENT) @map("contract_type")
  startDate             DateTime       @map("start_date")
  endDate               DateTime?      @map("end_date")
  salary                Decimal        @db.Decimal(15,2)
  currency              String         @default("RWF")
  s3Key                 String?        @map("s3_key")
  status                ContractStatus @default(ACTIVE)
  expiryAlert90Sent     Boolean        @default(false) @map("expiry_alert_90_sent")
  expiryAlert60Sent     Boolean        @default(false) @map("expiry_alert_60_sent")
  expiryAlert30Sent     Boolean        @default(false) @map("expiry_alert_30_sent")
  createdAt             DateTime       @default(now()) @map("created_at")

  employee              Employee       @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, status])
  @@map("employee_contracts")
}

model PayrollPeriod {
  id                    String       @id @default(uuid())
  tenantId              String       @map("tenant_id")
  clientId              String       @map("client_id")
  periodMonth           Int          @map("period_month")
  periodYear            Int          @map("period_year")
  status                PeriodStatus @default(DRAFT)
  preparedBy            String?      @map("prepared_by")
  submittedAt           DateTime?    @map("submitted_at")
  hrApprovedAt          DateTime?    @map("hr_approved_at")
  hrApprovedBy          String?      @map("hr_approved_by")
  mdApprovedAt          DateTime?    @map("md_approved_at")
  mdApprovedBy          String?      @map("md_approved_by")
  clientApprovedAt      DateTime?    @map("client_approved_at")
  clientApprovedBy      String?      @map("client_approved_by")
  finalizedAt           DateTime?    @map("finalized_at")
  notes                 String?
  createdAt             DateTime     @default(now()) @map("created_at")

  records               PayrollRecord[]
  approvals             PayrollApproval[]
  bankFiles             BankPaymentFile[]

  @@unique([tenantId, clientId, periodMonth, periodYear])
  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@map("payroll_periods")
}

model PayrollRecord {
  id                    String        @id @default(uuid())
  tenantId              String        @map("tenant_id")
  periodId              String        @map("period_id")
  employeeId            String        @map("employee_id")
  basicSalary           Decimal       @map("basic_salary") @db.Decimal(15,2)
  housingAllowance      Decimal       @default(0) @map("housing_allowance") @db.Decimal(15,2)
  transportAllowance    Decimal       @default(0) @map("transport_allowance") @db.Decimal(15,2)
  otherAllowances       Decimal       @default(0) @map("other_allowances") @db.Decimal(15,2)
  grossPay              Decimal       @map("gross_pay") @db.Decimal(15,2)
  paye                  Decimal       @default(0) @db.Decimal(15,2)
  rssbEmployee          Decimal       @default(0) @map("rssb_employee") @db.Decimal(15,2)
  rssbEmployer          Decimal       @default(0) @map("rssb_employer") @db.Decimal(15,2)
  rssbMedical           Decimal       @default(0) @map("rssb_medical") @db.Decimal(15,2)
  cbhi                  Decimal       @default(0) @db.Decimal(15,2)
  maternityLevy         Decimal       @default(0) @map("maternity_levy") @db.Decimal(15,2)
  occupationalHazard    Decimal       @default(0) @map("occupational_hazard") @db.Decimal(15,2)
  otherDeductions       Decimal       @default(0) @map("other_deductions") @db.Decimal(15,2)
  totalDeductions       Decimal       @map("total_deductions") @db.Decimal(15,2)
  netPay                Decimal       @map("net_pay") @db.Decimal(15,2)
  payslipS3Key          String?       @map("payslip_s3_key")
  payslipGeneratedAt    DateTime?     @map("payslip_generated_at")

  period                PayrollPeriod @relation(fields: [periodId], references: [id])
  employee              Employee      @relation(fields: [employeeId], references: [id])

  @@unique([periodId, employeeId])
  @@index([tenantId])
  @@index([periodId])
  @@map("payroll_records")
}

model PayrollApproval {
  id                    String         @id @default(uuid())
  tenantId              String         @map("tenant_id")
  periodId              String         @map("period_id")
  approverRole          ApproverRole   @map("approver_role")
  approverId            String         @map("approver_id")
  action                ApprovalAction
  comments              String?
  createdAt             DateTime       @default(now()) @map("created_at")

  period                PayrollPeriod  @relation(fields: [periodId], references: [id])

  @@index([periodId])
  @@map("payroll_approvals")
}

model BankPaymentFile {
  id                    String        @id @default(uuid())
  tenantId              String        @map("tenant_id")
  periodId              String        @map("period_id")
  s3Key                 String?       @map("s3_key")
  generatedAt           DateTime      @default(now()) @map("generated_at")
  generatedBy           String        @map("generated_by")
  totalAmount           Decimal       @map("total_amount") @db.Decimal(15,2)
  recordCount           Int           @map("record_count")

  period                PayrollPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId])
  @@map("bank_payment_files")
}

model OutsourcingAssignment {
  id                String                    @id @default(uuid())
  tenantId          String                    @map("tenant_id")
  employeeId        String                    @map("employee_id")
  clientName        String                    @map("client_name")
  clientId          String?                   @map("client_id")
  roleName          String                    @map("role_name")
  deploymentSite    String?                   @map("deployment_site")
  employmentType    OutsourcingEmploymentType @default(FULL_TIME) @map("employment_type")
  deploymentStatus  DeploymentStatus          @default(ACTIVE) @map("deployment_status")
  startDate         DateTime                  @map("start_date")
  endDate           DateTime?                 @map("end_date")
  availabilityDate  DateTime?                 @map("availability_date")
  monthlyFee        Decimal?                  @map("monthly_fee") @db.Decimal(14, 2)
  currency          String                    @default("RWF")
  noticePeriodDays  Int                       @default(30) @map("notice_period_days")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  employee          Employee                  @relation(fields: [employeeId], references: [id])
  contracts         SecondmentContract[]
  deploymentHistory DeploymentHistory[]

  @@index([tenantId])
  @@index([tenantId, clientName])
  @@index([tenantId, deploymentStatus])
  @@map("outsourcing_assignments")
}

model SecondmentContract {
  id                  String                   @id @default(uuid())
  tenantId            String                   @map("tenant_id")
  assignmentId        String                   @map("assignment_id")
  contractRef         String?                  @map("contract_ref")
  clientName          String                   @map("client_name")
  role                String
  billingRate         Decimal                  @map("billing_rate") @db.Decimal(14, 2)
  currency            String                   @default("RWF")
  workingHoursPerWeek Int                      @default(40) @map("working_hours_per_week")
  noticePeriodDays    Int                      @default(30) @map("notice_period_days")
  governingLaw        String?                  @map("governing_law")
  startDate           DateTime                 @map("start_date")
  endDate             DateTime?                @map("end_date")
  renewalDate         DateTime?                @map("renewal_date")
  status              SecondmentContractStatus @default(ACTIVE)
  terminationReason   String?                  @map("termination_reason")
  terminatedAt        DateTime?                @map("terminated_at")
  terminatedBy        String?                  @map("terminated_by")
  alert90Sent         Boolean                  @default(false) @map("alert_90_sent")
  alert60Sent         Boolean                  @default(false) @map("alert_60_sent")
  alert30Sent         Boolean                  @default(false) @map("alert_30_sent")
  s3Key               String?                  @map("s3_key")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  createdBy           String?                  @map("created_by")

  assignment          OutsourcingAssignment    @relation(fields: [assignmentId], references: [id])
  amendments          ContractAmendment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([assignmentId])
  @@map("secondment_contracts")
}

model ContractAmendment {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  contractId   String             @map("contract_id")
  changedBy    String             @map("changed_by")
  reason       String
  changesSummary String           @map("changes_summary")
  snapshotJson Json               @map("snapshot_json")
  createdAt    DateTime           @default(now()) @map("created_at")

  contract     SecondmentContract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@map("contract_amendments")
}

model DeploymentHistory {
  id           String                @id @default(uuid())
  tenantId     String                @map("tenant_id")
  assignmentId String                @map("assignment_id")
  clientName   String                @map("client_name")
  roleName     String                @map("role_name")
  startDate    DateTime              @map("start_date")
  endDate      DateTime?             @map("end_date")
  reason       String?
  createdAt    DateTime              @default(now()) @map("created_at")

  assignment   OutsourcingAssignment @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId])
  @@map("deployment_history")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String   // e.g. ANNUAL, SICK, MATERNITY, PATERNITY, UNPAID
  description String?
  defaultDays Decimal  @map("default_days") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@unique([tenantId, code])
  @@map("leave_types")
}

model Holiday {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  month     Int
  day       Int
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("holidays")
}

model LeaveRequest {
  id                    String      @id @default(uuid())
  tenantId              String      @map("tenant_id")
  employeeId            String      @map("employee_id")
  leaveTypeId           String      @map("leave_type_id")
  startDate             DateTime    @map("start_date")
  endDate               DateTime    @map("end_date")
  numberOfDays          Decimal     @map("number_of_days") @db.Decimal(5, 2)
  reason                String?
  status                LeaveStatus @default(PENDING)
  approvedById          String?     @map("approved_by_id")
  approvedAt            DateTime?   @map("approved_at")
  rejectionReason       String?     @map("rejection_reason")
  attachmentS3Key       String?     @map("attachment_s3_key")
  delegateToEmployeeId  String?     @map("delegate_to_employee_id")
  emergencyContactPhone String?     @map("emergency_contact_phone")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType   @relation(fields: [leaveTypeId], references: [id])
  delegateTo      Employee?   @relation("LeaveDelegate", fields: [delegateToEmployeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@map("leave_requests")
}

model LeaveBalance {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  employeeId    String    @map("employee_id")
  leaveTypeId   String    @map("leave_type_id")
  year          Int
  allocatedDays Decimal   @map("allocated_days") @db.Decimal(5, 2)
  usedDays      Decimal   @default(0) @map("used_days") @db.Decimal(5, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([tenantId])
  @@map("leave_balances")
}

enum CycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum GoalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum AppraisalStatus {
  SELF_ASSESSMENT
  MANAGER_REVIEW
  HR_REVIEW
  COMPLETED
}

enum FeedbackRelationship {
  PEER
  SUBORDINATE
  MANAGER
}

enum FeedbackStatus {
  PENDING
  COMPLETED
  DECLINED
}

model AppraisalCycle {
  id                      String        @id @default(uuid())
  tenantId                String        @map("tenant_id")
  clientId                String?       @map("client_id")
  name                    String
  frequency               String        @default("ANNUAL")
  startDate               DateTime      @map("start_date")
  endDate                 DateTime      @map("end_date")
  selfAssessmentDeadline  DateTime      @map("self_assessment_deadline")
  managerReviewDeadline   DateTime      @map("manager_review_deadline")
  hrValidationDeadline    DateTime      @map("hr_validation_deadline")
  status                  CycleStatus   @default(DRAFT)
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  appraisals              Appraisal[]
  goals                   Goal[]

  @@index([tenantId])
  @@map("appraisal_cycles")
}

model CompetencyFramework {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  competencies Competency[]

  @@index([tenantId])
  @@map("competency_frameworks")
}

model Competency {
  id          String              @id @default(uuid())
  frameworkId String              @map("framework_id")
  name        String
  description String?
  weight      Decimal             @default(1.0) @db.Decimal(5, 2)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  framework   CompetencyFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  ratings     AppraisalCompetencyRating[]

  @@map("competencies")
}

enum GoalType {
  GOAL
  KPI
}

model Goal {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  employeeId        String         @map("employee_id")
  appraisalCycleId  String?        @map("appraisal_cycle_id")
  type              GoalType       @default(GOAL)
  kpiPeriodId       String?        @map("kpi_period_id")
  title             String
  description       String?
  target            String
  measurementMethod String         @map("measurement_method")
  weight            Decimal        @db.Decimal(5, 2)
  deadline          DateTime
  status            GoalStatus     @default(DRAFT)
  progress          Decimal        @default(0.0) @db.Decimal(5, 2)
  managerComment    String?        @map("manager_comment")
  objectiveId       String?        @map("objective_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle             AppraisalCycle? @relation(fields: [appraisalCycleId], references: [id], onDelete: Cascade)
  kpiPeriod         KpiPeriod?      @relation(fields: [kpiPeriodId], references: [id], onDelete: SetNull)
  ratings           AppraisalGoalRating[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, type, kpiPeriodId])
  @@map("goals")
}

enum KpiPeriodStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model KpiPeriod {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  name      String
  startDate DateTime        @map("start_date")
  endDate   DateTime        @map("end_date")
  status    KpiPeriodStatus @default(DRAFT)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  kpis      Goal[]
  teamKpis  TeamKpiSubmission[]

  @@index([tenantId])
  @@map("kpi_periods")
}

enum TeamKpiStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model TeamKpiSubmission {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  teamId            String        @map("team_id")
  teamLeaderId      String        @map("team_leader_id")
  kpiPeriodId       String        @map("kpi_period_id")
  status            TeamKpiStatus @default(DRAFT)
  memberCount       Int           @default(0) @map("member_count")
  approvedKpiCount  Int           @default(0) @map("approved_kpi_count")
  avgProgress       Decimal       @default(0.0) @db.Decimal(5, 2) @map("avg_progress")
  summary           String?
  submittedAt       DateTime?     @map("submitted_at")
  reviewerId        String?       @map("reviewer_id")
  reviewedAt        DateTime?     @map("reviewed_at")
  reviewComment     String?       @map("review_comment")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  team              Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  period            KpiPeriod     @relation(fields: [kpiPeriodId], references: [id], onDelete: Cascade)

  @@unique([teamId, kpiPeriodId])
  @@index([tenantId])
  @@map("team_kpi_submissions")
}

model GoalTemplate {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  roleType          String?  @map("role_type")
  title             String
  description       String?
  target            String
  measurementMethod String   @map("measurement_method")
  weight            Decimal  @default(20.0) @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("goal_templates")
}

model Appraisal {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  employeeId        String         @map("employee_id")
  cycleId           String         @map("cycle_id")
  status            AppraisalStatus @default(SELF_ASSESSMENT)
  selfScore         Decimal?       @map("self_score") @db.Decimal(5, 2)
  managerScore      Decimal?       @map("manager_score") @db.Decimal(5, 2)
  hrScore           Decimal?       @map("hr_score") @db.Decimal(5, 2)
  finalScore        Decimal?       @map("final_score") @db.Decimal(5, 2)
  managerAdjustment Decimal?       @map("manager_adjustment") @db.Decimal(5, 2)
  selfComment       String?        @map("self_comment")
  managerComment    String?        @map("manager_comment")
  hrComment         String?        @map("hr_comment")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle             AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  goalRatings       AppraisalGoalRating[]
  competencyRatings AppraisalCompetencyRating[]
  feedbackRequests  FeedbackRequest[]
  improvementPlans  PerformanceImprovementPlan[]

  @@unique([employeeId, cycleId])
  @@index([tenantId])
  @@map("appraisals")
}

model AppraisalGoalRating {
  id             String    @id @default(uuid())
  appraisalId    String    @map("appraisal_id")
  goalId         String    @map("goal_id")
  selfRating     Decimal?  @map("self_rating") @db.Decimal(5, 2)
  selfComment    String?   @map("self_comment")
  managerRating  Decimal?  @map("manager_rating") @db.Decimal(5, 2)
  managerComment String?   @map("manager_comment")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  appraisal      Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  goal           Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([appraisalId, goalId])
  @@map("appraisal_goal_ratings")
}

model AppraisalCompetencyRating {
  id             String     @id @default(uuid())
  appraisalId    String     @map("appraisal_id")
  competencyId   String     @map("competency_id")
  selfRating     Decimal?   @map("self_rating") @db.Decimal(5, 2)
  selfComment    String?    @map("self_comment")
  managerRating  Decimal?   @map("manager_rating") @db.Decimal(5, 2)
  managerComment String?    @map("manager_comment")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  appraisal      Appraisal  @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  competency     Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([appraisalId, competencyId])
  @@map("appraisal_competency_ratings")
}

model FeedbackRequest {
  id           String               @id @default(uuid())
  tenantId     String               @map("tenant_id")
  appraisalId  String               @map("appraisal_id")
  employeeId   String               @map("employee_id")
  reviewerId   String               @map("reviewer_id")
  relationship FeedbackRelationship
  status       FeedbackStatus       @default(PENDING)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  appraisal    Appraisal            @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  employee     Employee             @relation("FeedbackNominee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer     Employee             @relation("FeedbackReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  response     FeedbackResponse?

  @@index([tenantId])
  @@index([appraisalId])
  @@map("feedback_requests")
}

model FeedbackResponse {
  id                String          @id @default(uuid())
  feedbackRequestId String          @unique @map("feedback_request_id")
  anonymized        Boolean         @default(true)
  competencyRatings Json
  generalComment    String?         @map("general_comment")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  request           FeedbackRequest @relation(fields: [feedbackRequestId], references: [id], onDelete: Cascade)

  @@map("feedback_responses")
}

enum PipStatus {
  ACTIVE
  EXTENDED
  SUCCEEDED
  ESCALATED
  CLOSED
}

model PerformanceImprovementPlan {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  employeeId      String    @map("employee_id")
  appraisalId     String?   @map("appraisal_id")
  managerId       String?   @map("manager_id")
  reason          String
  objectives      String
  supportProvided String?   @map("support_provided")
  startDate       DateTime  @map("start_date")
  reviewDate      DateTime  @map("review_date")
  endDate         DateTime? @map("end_date")
  status          PipStatus @default(ACTIVE)
  outcome         String?
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  appraisal       Appraisal? @relation(fields: [appraisalId], references: [id], onDelete: SetNull)
  checkIns        PipCheckIn[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([employeeId])
  @@map("performance_improvement_plans")
}

model PipCheckIn {
  id        String   @id @default(uuid())
  pipId     String   @map("pip_id")
  note      String
  status    String?
  createdAt DateTime @default(now()) @map("created_at")

  pip       PerformanceImprovementPlan @relation(fields: [pipId], references: [id], onDelete: Cascade)

  @@index([pipId])
  @@map("pip_check_ins")
}

enum PermitType {
  WORK_PERMIT
  VISA
  RESIDENCE_PERMIT
}

enum PermitStatus {
  APPROVED
  EXPIRED
  REVOKED
}

enum ChecklistItemStatus {
  PENDING
  UPLOADED
  VERIFIED
}

model Permit {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  employeeId   String       @map("employee_id")
  permitNumber String       @map("permit_number")
  permitType   PermitType   @map("permit_type")
  country      String       @default("RW")
  expiryDate   DateTime     @map("expiry_date")
  status       PermitStatus @default(APPROVED)
  alert90Sent  Boolean      @default(false) @map("alert_90_sent")
  alert60Sent  Boolean      @default(false) @map("alert_60_sent")
  alert30Sent  Boolean      @default(false) @map("alert_30_sent")
  alert7Sent   Boolean      @default(false) @map("alert_7_sent")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  employee       Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checklistItems PermitChecklistItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([employeeId])
  @@map("permits")
}

model PermitChecklistItem {
  id           String              @id @default(uuid())
  tenantId     String              @map("tenant_id")
  permitId     String              @map("permit_id")
  documentName String              @map("document_name")
  status       ChecklistItemStatus @default(PENDING)
  fileKey      String?             @map("file_key")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  permit Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@index([permitId])
  @@map("permit_checklist_items")
}

model SecurityAuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  action     String
  resource   String
  resourceId String   @map("resource_id")
  payload    String
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@map("security_audit_logs")
}
