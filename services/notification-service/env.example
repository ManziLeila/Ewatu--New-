PORT=3015
SERVICE_NAME=notification-service
DATABASE_URL=postgresql://ewatu:ewatu_dev@127.0.0.1:15432/notifications_db
JWT_PUBLIC_KEY=<paste-public-pem-one-line-with-\n-escapes>
JWT_ISSUER=http://localhost:3011/auth
CORS_ORIGIN=http://127.0.0.1:5173
INTERNAL_API_KEY=change-me-in-production-long-random-string
IDENTITY_SERVICE_URL=http://127.0.0.1:3011

# Sender (use addresses your provider allows)
MAIL_FROM_NAME=E-Watu
MAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM=noreply@yourdomain.com

# ── Real email (recommended) — pick ONE: Resend OR SMTP ─────────────────────

# Resend: https://resend.com — leave SMTP_HOST empty when using this
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
# Until domain is verified, use onboarding@resend.dev (delivers only to your Resend account email)

# Gmail / Microsoft 365 / Brevo / SendGrid:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM_ADDRESS=your-email@gmail.com
# EMAIL_FROM=your-email@gmail.com

# ── Local fake inbox (only if you are NOT using real email above) ───────────
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# Requires: npm run db:up  →  http://localhost:8025
